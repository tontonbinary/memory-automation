{
  "skill_name": "memory-automation",
  "version": "2.2.0",
  "type": "public",
  "description": "分层记忆管理 Skill，实现 L0→L1→L2 的记忆流转",
  "agent_id": "code",
  "trigger_keywords": [
    "记住",
    "记忆",
    "distill",
    "distillation"
  ],
  "pattern_keywords": [
    "我喜欢",
    "我希望",
    "我觉得",
    "以后都",
    "我想要",
    "忘了吗"
  ],
  "heartbeat_interval_minutes": 10,
  "state_file": "memory/heartbeat-state.json",
  "memory_rules": "~/.openclaw/memory-rules.md",
  "l1_history_days": 7,
  "pattern_threshold": 3,
  "triggers": {
    "manual": {
      "enabled": true,
      "keywords": [
        "记住",
        "记忆",
        "distill",
        "distillation",
        "TODO",
        "暂存",
        "搁置",
        "先记录",
        "以后再聊",
        "记一下",
        "忘了吗"
      ],
      "case_sensitive": false
    },
    "agent_promise": {
      "enabled": true,
      "keywords": [
        "好，记到",
        "已记录到",
        "我会记住",
        "好，我记到",
        "已记到",
        "会记下来"
      ],
      "case_sensitive": false
    },
    "heartbeat": {
      "enabled": true,
      "interval_minutes": 360
    }
  },
  "paths": {
    "l1_template": "~/.openclaw/workspaces/{agent}/workspace/memory/{date}.md",
    "l2_dir": "~/.openclaw/workspaces/{agent}/workspace/memory/L2",
    "state_file": "memory/heartbeat-state.json",
    "memory_rules": "~/.openclaw/memory-rules.md"
  },
  "l2": {
    "enabled": true,
    "auto_promote_threshold": 3,
    "files": {
      "corrections": "corrections.md",
      "patterns": "patterns.md",
      "insights": "insights.md"
    },
    "insight_ttl_days": 7
  },
  "entry_point": "memory/automation.py",
  "l1_template": "~/.openclaw/workspaces/{agent}/workspace/memory/{date}.md",
  "session_processing": {
    "process_inactive": true,
    "max_age_days": 3,
    "min_message_count": 50,
    "process_order": "newest_first"
  }
}
